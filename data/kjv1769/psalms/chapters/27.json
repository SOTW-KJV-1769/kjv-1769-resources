{
  "schema_version": "1.0.0",
  "edition_id": "KJV1769",
  "book_code": "PSA",
  "chapter": 27,
  "verses": [
    {
      "id": "PSA.27.1",
      "edition_verse_id": "KJV1769:PSA.27.1",
      "verse": 1,
      "spans": [
        {
          "text": "The LORD ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " my light and my salvation; whom shall I fear? the LORD ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " the strength of my life; of whom shall I be afraid?",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.27.2",
      "edition_verse_id": "KJV1769:PSA.27.2",
      "verse": 2,
      "spans": [
        {
          "text": "When the wicked, ",
          "kind": "text"
        },
        {
          "text": "even",
          "kind": "supplied"
        },
        {
          "text": " mine enemies and my foes, came upon me to eat up my flesh, they stumbled and fell.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.27.3",
      "edition_verse_id": "KJV1769:PSA.27.3",
      "verse": 3,
      "spans": [
        {
          "text": "Though an host should encamp against me, my heart shall not fear: though war should rise against me, in this ",
          "kind": "text"
        },
        {
          "text": "will",
          "kind": "supplied"
        },
        {
          "text": " I ",
          "kind": "text"
        },
        {
          "text": "be",
          "kind": "supplied"
        },
        {
          "text": " confident.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.27.4",
      "edition_verse_id": "KJV1769:PSA.27.4",
      "verse": 4,
      "spans": [
        {
          "text": "One ",
          "kind": "text"
        },
        {
          "text": "thing",
          "kind": "supplied"
        },
        {
          "text": " have I desired of the LORD, that will I seek after; that I may dwell in the house of the LORD all the days of my life, to behold the beauty of the LORD, and to enquire in his temple.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.27.5",
      "edition_verse_id": "KJV1769:PSA.27.5",
      "verse": 5,
      "spans": [
        {
          "text": "For in the time of trouble he shall hide me in his pavilion: in the secret of his tabernacle shall he hide me; he shall set me up upon a rock.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.27.6",
      "edition_verse_id": "KJV1769:PSA.27.6",
      "verse": 6,
      "spans": [
        {
          "text": "And now shall mine head be lifted up above mine enemies round about me: therefore will I offer in his tabernacle sacrifices of joy; I will sing, yea, I will sing praises unto the LORD.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.27.7",
      "edition_verse_id": "KJV1769:PSA.27.7",
      "verse": 7,
      "spans": [
        {
          "text": "Hear, O LORD, ",
          "kind": "text"
        },
        {
          "text": "when",
          "kind": "supplied"
        },
        {
          "text": " I cry with my voice: have mercy also upon me, and answer me.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.27.8",
      "edition_verse_id": "KJV1769:PSA.27.8",
      "verse": 8,
      "spans": [
        {
          "text": "When thou saidst",
          "kind": "supplied"
        },
        {
          "text": ", Seek ye my face; my heart said unto thee, Thy face, LORD, will I seek.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.27.9",
      "edition_verse_id": "KJV1769:PSA.27.9",
      "verse": 9,
      "spans": [
        {
          "text": "Hide not thy face ",
          "kind": "text"
        },
        {
          "text": "far",
          "kind": "supplied"
        },
        {
          "text": " from me; put not thy servant away in anger: thou hast been my help; leave me not, neither forsake me, O God of my salvation.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.27.10",
      "edition_verse_id": "KJV1769:PSA.27.10",
      "verse": 10,
      "spans": [
        {
          "text": "When my father and my mother forsake me, then the LORD will take me up.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.27.11",
      "edition_verse_id": "KJV1769:PSA.27.11",
      "verse": 11,
      "spans": [
        {
          "text": "Teach me thy way, O LORD, and lead me in a plain path, because of mine enemies.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.27.12",
      "edition_verse_id": "KJV1769:PSA.27.12",
      "verse": 12,
      "spans": [
        {
          "text": "Deliver me not over unto the will of mine enemies: for false witnesses are risen up against me, and such as breathe out cruelty.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.27.13",
      "edition_verse_id": "KJV1769:PSA.27.13",
      "verse": 13,
      "spans": [
        {
          "text": "I had fainted",
          "kind": "supplied"
        },
        {
          "text": ", unless I had believed to see the goodness of the LORD in the land of the living.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.27.14",
      "edition_verse_id": "KJV1769:PSA.27.14",
      "verse": 14,
      "spans": [
        {
          "text": "Wait on the LORD: be of good courage, and he shall strengthen thine heart: wait, I say, on the LORD.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    }
  ]
}
