      "verse": 1,
      "spans": [
        {
          "text": "God ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " our refuge and strength, a very present help in trouble.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.46.2",
      "edition_verse_id": "KJV1769:PSA.46.2",
      "verse": 2,
      "spans": [
        {
          "text": "Therefore will not we fear, though the earth be removed, and though the mountains be carried into the midst of the sea;",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.46.3",
      "edition_verse_id": "KJV1769:PSA.46.3",
      "verse": 3,
      "spans": [
        {
          "text": "Though",
          "kind": "supplied"
        },
        {
          "text": " the waters thereof roar ",
          "kind": "text"
        },
        {
          "text": "and",
          "kind": "supplied"
        },
        {
          "text": " be troubled, ",
          "kind": "text"
        },
        {
          "text": "though",
          "kind": "supplied"
        },
        {
          "text": " the mountains shake with the swelling thereof. Selah.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
