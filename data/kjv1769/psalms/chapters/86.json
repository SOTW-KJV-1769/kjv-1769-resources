  "chapter": 86,
  "verses": [
    {
      "id": "PSA.86.1",
      "edition_verse_id": "KJV1769:PSA.86.1",
      "verse": 1,
      "spans": [
        {
          "text": "Bow down thine ear, O LORD, hear me: for I ",
          "kind": "text"
        },
        {
          "text": "am",
          "kind": "supplied"
        },
        {
          "text": " poor and needy.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.86.2",
      "edition_verse_id": "KJV1769:PSA.86.2",
      "verse": 2,
      "spans": [
        {
          "text": "Preserve my soul; for I ",
          "kind": "text"
        },
        {
          "text": "am",
          "kind": "supplied"
        },
        {
          "text": " holy: O thou my God, save thy servant that trusteth in thee.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.86.3",
      "edition_verse_id": "KJV1769:PSA.86.3",
      "verse": 3,
      "spans": [
        {
          "text": "Be merciful unto me, O Lord: for I cry unto thee daily.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.86.4",
      "edition_verse_id": "KJV1769:PSA.86.4",
      "verse": 4,
      "spans": [
        {
          "text": "Rejoice the soul of thy servant: for unto thee, O Lord, do I lift up my soul.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.86.5",
      "edition_verse_id": "KJV1769:PSA.86.5",
      "verse": 5,
      "spans": [
        {
          "text": "For thou, Lord, ",
          "kind": "text"
        },
        {
          "text": "art",
          "kind": "supplied"
        },
        {
          "text": " good, and ready to forgive; and plenteous in mercy unto all them that call upon thee.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.86.6",
      "edition_verse_id": "KJV1769:PSA.86.6",
      "verse": 6,
      "spans": [
        {
          "text": "Give ear, O LORD, unto my prayer; and attend to the voice of my supplications.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.86.7",
      "edition_verse_id": "KJV1769:PSA.86.7",
      "verse": 7,
      "spans": [
        {
          "text": "In the day of my trouble I will call upon thee: for thou wilt answer me.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.86.8",
      "edition_verse_id": "KJV1769:PSA.86.8",
      "verse": 8,
      "spans": [
        {
          "text": "Among the gods ",
          "kind": "text"
        },
        {
          "text": "there is",
          "kind": "supplied"
        },
        {
          "text": " none like unto thee, O Lord; neither ",
          "kind": "text"
        },
        {
          "text": "are there any works",
          "kind": "supplied"
        },
        {
          "text": " like unto thy works.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.86.9",
      "edition_verse_id": "KJV1769:PSA.86.9",
      "verse": 9,
      "spans": [
        {
          "text": "All nations whom thou hast made shall come and worship before thee, O Lord; and shall glorify thy name.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.86.10",
      "edition_verse_id": "KJV1769:PSA.86.10",
      "verse": 10,
      "spans": [
        {
          "text": "For thou ",
          "kind": "text"
        },
        {
          "text": "art",
          "kind": "supplied"
        },
        {
          "text": " great, and doest wondrous things: thou ",
          "kind": "text"
        },
        {
          "text": "art",
          "kind": "supplied"
        },
        {
          "text": " God alone.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.86.11",
      "edition_verse_id": "KJV1769:PSA.86.11",
      "verse": 11,
      "spans": [
        {
          "text": "Teach me thy way, O LORD; I will walk in thy truth: unite my heart to fear thy name.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.86.12",
      "edition_verse_id": "KJV1769:PSA.86.12",
      "verse": 12,
      "spans": [
        {
          "text": "I will praise thee, O Lord my God, with all my heart: and I will glorify thy name for evermore.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.86.13",
      "edition_verse_id": "KJV1769:PSA.86.13",
      "verse": 13,
      "spans": [
        {
          "text": "For great ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " thy mercy toward me: and thou hast delivered my soul from the lowest hell.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.86.14",
      "edition_verse_id": "KJV1769:PSA.86.14",
      "verse": 14,
      "spans": [
        {
          "text": "O God, the proud are risen against me, and the assemblies of violent ",
          "kind": "text"
        },
        {
          "text": "men",
          "kind": "supplied"
        },
        {
          "text": " have sought after my soul; and have not set thee before them.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.86.15",
      "edition_verse_id": "KJV1769:PSA.86.15",
      "verse": 15,
      "spans": [
        {
          "text": "But thou, O Lord, ",
          "kind": "text"
        },
        {
          "text": "art",
          "kind": "supplied"
        },
        {
          "text": " a God full of compassion, and gracious, longsuffering, and plenteous in mercy and truth.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.86.16",
      "edition_verse_id": "KJV1769:PSA.86.16",
      "verse": 16,
      "spans": [
        {
          "text": "O turn unto me, and have mercy upon me; give thy strength unto thy servant, and save the son of thine handmaid.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.86.17",
      "edition_verse_id": "KJV1769:PSA.86.17",
      "verse": 17,
      "spans": [
        {
          "text": "Shew me a token for good; that they which hate me may see ",
          "kind": "text"
        },
        {
          "text": "it",
          "kind": "supplied"
        },
        {
          "text": ", and be ashamed: because thou, LORD, hast holpen me, and comforted me.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    }
  ]
}
