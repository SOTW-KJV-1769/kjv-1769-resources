      "verse": 1,
      "spans": [
        {
          "text": "In the LORD put I my trust: how say ye to my soul, Flee ",
          "kind": "text"
        },
        {
          "text": "as",
          "kind": "supplied"
        },
        {
          "text": " a bird to your mountain?",
