        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.110.4",
      "edition_verse_id": "KJV1769:PSA.110.4",
      "verse": 4,
      "spans": [
        {
          "text": "The LORD hath sworn, and will not repent, Thou ",
          "kind": "text"
        },
        {
          "text": "art",
          "kind": "supplied"
        },
        {
          "text": " a priest for ever after the order of Melchizedek.",
