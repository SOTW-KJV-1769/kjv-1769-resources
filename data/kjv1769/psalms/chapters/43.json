      "edition_verse_id": "KJV1769:PSA.43.5",
      "verse": 5,
      "spans": [
        {
          "text": "Why art thou cast down, O my soul? and why art thou disquieted within me? hope in God: for I shall yet praise him, ",
          "kind": "text"
        },
        {
          "text": "who is",
          "kind": "supplied"
        },
        {
          "text": " the health of my countenance, and my God.",
          "kind": "text"
        }
      ],
