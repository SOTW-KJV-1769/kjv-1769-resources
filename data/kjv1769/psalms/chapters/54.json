      "edition_verse_id": "KJV1769:PSA.54.1",
      "verse": 1,
      "spans": [
        {
          "text": "Save me, O God, by thy name, and judge me by thy strength.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.54.2",
      "edition_verse_id": "KJV1769:PSA.54.2",
      "verse": 2,
      "spans": [
        {
          "text": "Hear my prayer, O God; give ear to the words of my mouth.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.54.3",
      "edition_verse_id": "KJV1769:PSA.54.3",
      "verse": 3,
      "spans": [
        {
          "text": "For strangers are risen up against me, and oppressors seek after my soul: they have not set God before them. Selah.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.54.4",
      "edition_verse_id": "KJV1769:PSA.54.4",
      "verse": 4,
      "spans": [
        {
          "text": "Behold, God ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " mine helper: the Lord ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " with them that uphold my soul.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.54.5",
      "edition_verse_id": "KJV1769:PSA.54.5",
      "verse": 5,
      "spans": [
        {
          "text": "He shall reward evil unto mine enemies: cut them off in thy truth.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.54.6",
      "edition_verse_id": "KJV1769:PSA.54.6",
      "verse": 6,
      "spans": [
        {
          "text": "I will freely sacrifice unto thee: I will praise thy name, O LORD; for ",
          "kind": "text"
        },
        {
          "text": "it is",
          "kind": "supplied"
        },
        {
          "text": " good.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.54.7",
      "edition_verse_id": "KJV1769:PSA.54.7",
      "verse": 7,
      "spans": [
        {
          "text": "For he hath delivered me out of all trouble: and mine eye hath seen ",
          "kind": "text"
        },
        {
          "text": "his desire",
          "kind": "supplied"
        },
        {
          "text": " upon mine enemies.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    }
