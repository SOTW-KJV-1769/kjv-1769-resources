      "paragraph_start": false
    },
    {
      "id": "NUM.28.14",
      "edition_verse_id": "KJV1769:NUM.28.14",
      "verse": 14,
      "spans": [
        {
          "text": "And their drink offerings shall be half an hin of wine unto a bullock, and the third ",
          "kind": "text"
        },
        {
          "text": "part",
          "kind": "supplied"
        },
        {
          "text": " of an hin unto a ram, and a fourth ",
          "kind": "text"
        },
        {
          "text": "part",
          "kind": "supplied"
        },
        {
          "text": " of an hin unto a lamb: this ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " the burnt offering of every month throughout the months of the year.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "NUM.28.15",
      "edition_verse_id": "KJV1769:NUM.28.15",
      "verse": 15,
      "spans": [
        {
          "text": "And one kid of the goats for a sin offering unto the LORD shall be offered, beside the continual burnt offering, and his drink offering.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "NUM.28.16",
      "edition_verse_id": "KJV1769:NUM.28.16",
      "verse": 16,
      "spans": [
        {
          "text": "And in the fourteenth day of the first month ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " the passover of the LORD.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
