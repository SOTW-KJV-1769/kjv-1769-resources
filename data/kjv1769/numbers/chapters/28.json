  "book_code": "NUM",
  "chapter": 28,
  "verses": [
    {
      "id": "NUM.28.1",
      "edition_verse_id": "KJV1769:NUM.28.1",
      "verse": 1,
      "spans": [
        {
          "text": "And the LORD spake unto Moses, saying,",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "NUM.28.2",
      "edition_verse_id": "KJV1769:NUM.28.2",
      "verse": 2,
      "spans": [
        {
          "text": "Command the children of Israel, and say unto them, My offering, ",
          "kind": "text"
        },
        {
          "text": "and",
          "kind": "supplied"
        },
        {
          "text": " my bread for my sacrifices made by fire, ",
          "kind": "text"
        },
        {
          "text": "for",
          "kind": "supplied"
        },
        {
          "text": " a sweet savour unto me, shall ye observe to offer unto me in their due season.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "NUM.28.3",
      "edition_verse_id": "KJV1769:NUM.28.3",
      "verse": 3,
      "spans": [
        {
          "text": "And thou shalt say unto them, This ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " the offering made by fire which ye shall offer unto the LORD; two lambs of the first year without spot day by day, ",
          "kind": "text"
        },
        {
          "text": "for",
          "kind": "supplied"
        },
        {
          "text": " a continual burnt offering.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "NUM.28.4",
      "edition_verse_id": "KJV1769:NUM.28.4",
      "verse": 4,
      "spans": [
        {
          "text": "The one lamb shalt thou offer in the morning, and the other lamb shalt thou offer at even;",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "NUM.28.5",
      "edition_verse_id": "KJV1769:NUM.28.5",
      "verse": 5,
      "spans": [
        {
          "text": "And a tenth ",
          "kind": "text"
        },
        {
          "text": "part",
          "kind": "supplied"
        },
        {
          "text": " of an ephah of flour for a meat offering, mingled with the fourth ",
          "kind": "text"
        },
        {
          "text": "part",
          "kind": "supplied"
        },
        {
          "text": " of an hin of beaten oil.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "NUM.28.6",
      "edition_verse_id": "KJV1769:NUM.28.6",
      "verse": 6,
      "spans": [
        {
          "text": "It is",
          "kind": "supplied"
        },
        {
          "text": " a continual burnt offering, which was ordained in mount Sinai for a sweet savour, a sacrifice made by fire unto the LORD.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "NUM.28.7",
      "edition_verse_id": "KJV1769:NUM.28.7",
      "verse": 7,
      "spans": [
        {
          "text": "And the drink offering thereof ",
          "kind": "text"
        },
        {
          "text": "shall be",
          "kind": "supplied"
        },
        {
          "text": " the fourth ",
          "kind": "text"
        },
        {
          "text": "part",
          "kind": "supplied"
        },
        {
          "text": " of an hin for the one lamb: in the holy ",
          "kind": "text"
        },
        {
          "text": "place",
          "kind": "supplied"
        },
        {
          "text": " shalt thou cause the strong wine to be poured unto the LORD ",
          "kind": "text"
        },
        {
          "text": "for",
          "kind": "supplied"
        },
        {
          "text": " a drink offering.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "NUM.28.8",
      "edition_verse_id": "KJV1769:NUM.28.8",
      "verse": 8,
      "spans": [
        {
          "text": "And the other lamb shalt thou offer at even: as the meat offering of the morning, and as the drink offering thereof, thou shalt offer ",
          "kind": "text"
        },
        {
          "text": "it",
          "kind": "supplied"
        },
        {
          "text": ", a sacrifice made by fire, of a sweet savour unto the LORD.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "NUM.28.9",
      "edition_verse_id": "KJV1769:NUM.28.9",
      "verse": 9,
      "spans": [
        {
          "text": "¶ And on the sabbath day two lambs of the first year without spot, and two tenth deals of flour ",
          "kind": "text"
        },
        {
          "text": "for",
          "kind": "supplied"
        },
        {
          "text": " a meat offering, mingled with oil, and the drink offering thereof:",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "NUM.28.10",
      "edition_verse_id": "KJV1769:NUM.28.10",
      "verse": 10,
      "spans": [
        {
          "text": "This is",
          "kind": "supplied"
        },
        {
          "text": " the burnt offering of every sabbath, beside the continual burnt offering, and his drink offering.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "NUM.28.11",
      "edition_verse_id": "KJV1769:NUM.28.11",
      "verse": 11,
      "spans": [
        {
          "text": "¶ And in the beginnings of your months ye shall offer a burnt offering unto the LORD; two young bullocks, and one ram, seven lambs of the first year without spot;",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "NUM.28.12",
      "edition_verse_id": "KJV1769:NUM.28.12",
      "verse": 12,
      "spans": [
        {
          "text": "And three tenth deals of flour ",
          "kind": "text"
        },
        {
          "text": "for",
          "kind": "supplied"
        },
        {
          "text": " a meat offering, mingled with oil, for one bullock; and two tenth deals of flour ",
          "kind": "text"
        },
        {
          "text": "for",
          "kind": "supplied"
        },
        {
          "text": " a meat offering, mingled with oil, for one ram;",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "NUM.28.13",
      "edition_verse_id": "KJV1769:NUM.28.13",
      "verse": 13,
      "spans": [
        {
          "text": "And a several tenth deal of flour mingled with oil ",
          "kind": "text"
        },
        {
          "text": "for",
          "kind": "supplied"
        },
        {
          "text": " a meat offering unto one lamb; ",
          "kind": "text"
        },
        {
          "text": "for",
          "kind": "supplied"
        },
        {
          "text": " a burnt offering of a sweet savour, a sacrifice made by fire unto the LORD.",
          "kind": "text"
        }
