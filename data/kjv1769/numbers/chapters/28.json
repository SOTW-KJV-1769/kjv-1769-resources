      "verse": 19,
      "spans": [
        {
          "text": "But ye shall offer a sacrifice made by fire ",
          "kind": "text"
        },
        {
          "text": "for",
          "kind": "supplied"
        },
        {
          "text": " a burnt offering unto the LORD; two young bullocks, and one ram, and seven lambs of the first year: they shall be unto you without blemish:",
