      "verse": 1,
      "spans": [
        {
          "text": "And God spake all these words, saying,",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "EXO.20.2",
      "edition_verse_id": "KJV1769:EXO.20.2",
      "verse": 2,
      "spans": [
        {
          "text": "I ",
          "kind": "text"
        },
        {
          "text": "am",
          "kind": "supplied"
        },
        {
          "text": " the LORD thy God, which have brought thee out of the land of Egypt, out of the house of bondage.",
