        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.20.4",
      "edition_verse_id": "KJV1769:EXO.20.4",
      "verse": 4,
      "spans": [
        {
          "text": "Thou shalt not make unto thee any graven image, or any likeness ",
          "kind": "text"
        },
        {
          "text": "of any thing",
