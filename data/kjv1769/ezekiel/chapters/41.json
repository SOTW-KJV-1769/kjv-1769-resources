      "paragraph_start": false
    },
    {
      "id": "EZK.41.17",
      "edition_verse_id": "KJV1769:EZK.41.17",
      "verse": 17,
      "spans": [
        {
          "text": "To that above the door, even unto the inner house, and without, and by all the wall round about within and without, by measure.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EZK.41.18",
      "edition_verse_id": "KJV1769:EZK.41.18",
      "verse": 18,
      "spans": [
