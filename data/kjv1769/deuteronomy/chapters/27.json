      "edition_verse_id": "KJV1769:DEU.27.10",
      "verse": 10,
      "spans": [
        {
          "text": "Thou shalt therefore obey the voice of the LORD thy God, and do his commandments and his statutes, which I command thee this day.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "DEU.27.11",
      "edition_verse_id": "KJV1769:DEU.27.11",
      "verse": 11,
      "spans": [
        {
