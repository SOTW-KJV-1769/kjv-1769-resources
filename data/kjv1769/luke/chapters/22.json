    {
      "id": "LUK.22.63",
      "edition_verse_id": "KJV1769:LUK.22.63",
      "verse": 63,
      "spans": [
        {
          "text": "¶ And the men that held Jesus mocked him, and smote ",
          "kind": "text"
        },
        {
          "text": "him",
          "kind": "supplied"
        },
        {
          "text": ".",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
