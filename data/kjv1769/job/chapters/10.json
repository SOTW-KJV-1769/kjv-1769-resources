{
  "schema_version": "1.0.0",
  "edition_id": "KJV1769",
  "book_code": "JOB",
  "chapter": 10,
  "verses": [
    {
      "id": "JOB.10.1",
      "edition_verse_id": "KJV1769:JOB.10.1",
      "verse": 1,
      "spans": [
        {
          "text": "My soul is weary of my life; I will leave my complaint upon myself; I will speak in the bitterness of my soul.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "JOB.10.2",
      "edition_verse_id": "KJV1769:JOB.10.2",
      "verse": 2,
      "spans": [
        {
          "text": "I will say unto God, Do not condemn me; shew me wherefore thou contendest with me.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "JOB.10.3",
      "edition_verse_id": "KJV1769:JOB.10.3",
      "verse": 3,
      "spans": [
        {
          "text": "Is it",
          "kind": "supplied"
        },
        {
          "text": " good unto thee that thou shouldest oppress, that thou shouldest despise the work of thine hands, and shine upon the counsel of the wicked?",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "JOB.10.4",
      "edition_verse_id": "KJV1769:JOB.10.4",
      "verse": 4,
      "spans": [
        {
          "text": "Hast thou eyes of flesh? or seest thou as man seeth?",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "JOB.10.5",
      "edition_verse_id": "KJV1769:JOB.10.5",
      "verse": 5,
      "spans": [
        {
          "text": "Are",
          "kind": "supplied"
        },
        {
          "text": " thy days as the days of man? ",
          "kind": "text"
        },
        {
          "text": "are",
          "kind": "supplied"
        },
        {
          "text": " thy years as man’s days,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "JOB.10.6",
      "edition_verse_id": "KJV1769:JOB.10.6",
      "verse": 6,
      "spans": [
        {
          "text": "That thou enquirest after mine iniquity, and searchest after my sin?",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "JOB.10.7",
      "edition_verse_id": "KJV1769:JOB.10.7",
      "verse": 7,
      "spans": [
        {
          "text": "Thou knowest that I am not wicked; and ",
          "kind": "text"
        },
        {
          "text": "there is",
          "kind": "supplied"
        },
        {
          "text": " none that can deliver out of thine hand.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "JOB.10.8",
      "edition_verse_id": "KJV1769:JOB.10.8",
      "verse": 8,
      "spans": [
        {
          "text": "Thine hands have made me and fashioned me together round about; yet thou dost destroy me.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "JOB.10.9",
      "edition_verse_id": "KJV1769:JOB.10.9",
      "verse": 9,
      "spans": [
        {
          "text": "Remember, I beseech thee, that thou hast made me as the clay; and wilt thou bring me into dust again?",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "JOB.10.10",
      "edition_verse_id": "KJV1769:JOB.10.10",
      "verse": 10,
      "spans": [
        {
          "text": "Hast thou not poured me out as milk, and curdled me like cheese?",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "JOB.10.11",
      "edition_verse_id": "KJV1769:JOB.10.11",
      "verse": 11,
      "spans": [
        {
          "text": "Thou hast clothed me with skin and flesh, and hast fenced me with bones and sinews.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "JOB.10.12",
      "edition_verse_id": "KJV1769:JOB.10.12",
      "verse": 12,
      "spans": [
        {
          "text": "Thou hast granted me life and favour, and thy visitation hath preserved my spirit.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "JOB.10.13",
      "edition_verse_id": "KJV1769:JOB.10.13",
      "verse": 13,
      "spans": [
        {
          "text": "And these ",
          "kind": "text"
        },
        {
          "text": "things",
          "kind": "supplied"
        },
        {
          "text": " hast thou hid in thine heart: I know that this ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " with thee.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "JOB.10.14",
      "edition_verse_id": "KJV1769:JOB.10.14",
      "verse": 14,
      "spans": [
        {
          "text": "If I sin, then thou markest me, and thou wilt not acquit me from mine iniquity.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "JOB.10.15",
      "edition_verse_id": "KJV1769:JOB.10.15",
      "verse": 15,
      "spans": [
        {
          "text": "If I be wicked, woe unto me; and ",
          "kind": "text"
        },
        {
          "text": "if",
          "kind": "supplied"
        },
        {
          "text": " I be righteous, ",
          "kind": "text"
        },
        {
          "text": "yet",
          "kind": "supplied"
        },
        {
          "text": " will I not lift up my head. ",
          "kind": "text"
        },
        {
          "text": "I am",
          "kind": "supplied"
        },
        {
          "text": " full of confusion; therefore see thou mine affliction;",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "JOB.10.16",
      "edition_verse_id": "KJV1769:JOB.10.16",
      "verse": 16,
      "spans": [
        {
          "text": "For it increaseth. Thou huntest me as a fierce lion: and again thou shewest thyself marvellous upon me.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "JOB.10.17",
      "edition_verse_id": "KJV1769:JOB.10.17",
      "verse": 17,
      "spans": [
        {
          "text": "Thou renewest thy witnesses against me, and increasest thine indignation upon me; changes and war ",
          "kind": "text"
        },
        {
          "text": "are",
          "kind": "supplied"
        },
        {
          "text": " against me.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "JOB.10.18",
      "edition_verse_id": "KJV1769:JOB.10.18",
      "verse": 18,
      "spans": [
        {
          "text": "Wherefore then hast thou brought me forth out of the womb? Oh that I had given up the ghost, and no eye had seen me!",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "JOB.10.19",
      "edition_verse_id": "KJV1769:JOB.10.19",
      "verse": 19,
      "spans": [
        {
          "text": "I should have been as though I had not been; I should have been carried from the womb to the grave.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "JOB.10.20",
      "edition_verse_id": "KJV1769:JOB.10.20",
      "verse": 20,
      "spans": [
        {
          "text": "Are",
          "kind": "supplied"
        },
        {
          "text": " not my days few? cease ",
          "kind": "text"
        },
        {
          "text": "then, and",
          "kind": "supplied"
        },
        {
          "text": " let me alone, that I may take comfort a little,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "JOB.10.21",
      "edition_verse_id": "KJV1769:JOB.10.21",
      "verse": 21,
      "spans": [
        {
          "text": "Before I go ",
          "kind": "text"
        },
        {
          "text": "whence",
          "kind": "supplied"
        },
        {
          "text": " I shall not return, ",
          "kind": "text"
        },
        {
          "text": "even",
          "kind": "supplied"
        },
        {
          "text": " to the land of darkness and the shadow of death;",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "JOB.10.22",
      "edition_verse_id": "KJV1769:JOB.10.22",
      "verse": 22,
      "spans": [
        {
          "text": "A land of darkness, as darkness ",
          "kind": "text"
        },
        {
          "text": "itself; and",
          "kind": "supplied"
        },
        {
          "text": " of the shadow of death, without any order, and ",
          "kind": "text"
        },
        {
          "text": "where",
          "kind": "supplied"
        },
        {
          "text": " the light ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " as darkness.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    }
  ]
}
