      "edition_verse_id": "KJV1769:LEV.19.30",
      "verse": 30,
      "spans": [
        {
          "text": "¶ Ye shall keep my sabbaths, and reverence my sanctuary: I ",
          "kind": "text"
        },
        {
          "text": "am",
          "kind": "supplied"
        },
        {
          "text": " the LORD.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
