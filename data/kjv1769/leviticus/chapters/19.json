  "book_code": "LEV",
  "chapter": 19,
  "verses": [
    {
      "id": "LEV.19.1",
      "edition_verse_id": "KJV1769:LEV.19.1",
      "verse": 1,
      "spans": [
        {
          "text": "And the LORD spake unto Moses, saying,",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "LEV.19.2",
      "edition_verse_id": "KJV1769:LEV.19.2",
      "verse": 2,
      "spans": [
        {
          "text": "Speak unto all the congregation of the children of Israel, and say unto them, Ye shall be holy: for I the LORD your God ",
          "kind": "text"
        },
        {
          "text": "am",
          "kind": "supplied"
        },
        {
          "text": " holy.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LEV.19.3",
      "edition_verse_id": "KJV1769:LEV.19.3",
      "verse": 3,
      "spans": [
        {
          "text": "¶ Ye shall fear every man his mother, and his father, and keep my sabbaths: I ",
          "kind": "text"
        },
        {
          "text": "am",
          "kind": "supplied"
        },
        {
          "text": " the LORD your God.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "LEV.19.4",
      "edition_verse_id": "KJV1769:LEV.19.4",
      "verse": 4,
      "spans": [
        {
          "text": "¶ Turn ye not unto idols, nor make to yourselves molten gods: I ",
          "kind": "text"
        },
        {
          "text": "am",
          "kind": "supplied"
        },
        {
          "text": " the LORD your God.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "LEV.19.5",
      "edition_verse_id": "KJV1769:LEV.19.5",
      "verse": 5,
      "spans": [
        {
          "text": "¶ And if ye offer a sacrifice of peace offerings unto the LORD, ye shall offer it at your own will.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "LEV.19.6",
      "edition_verse_id": "KJV1769:LEV.19.6",
      "verse": 6,
      "spans": [
        {
          "text": "It shall be eaten the same day ye offer it, and on the morrow: and if ought remain until the third day, it shall be burnt in the fire.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LEV.19.7",
      "edition_verse_id": "KJV1769:LEV.19.7",
      "verse": 7,
      "spans": [
        {
          "text": "And if it be eaten at all on the third day, it ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " abominable; it shall not be accepted.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LEV.19.8",
      "edition_verse_id": "KJV1769:LEV.19.8",
      "verse": 8,
      "spans": [
        {
          "text": "Therefore ",
          "kind": "text"
        },
        {
          "text": "every one",
          "kind": "supplied"
        },
        {
          "text": " that eateth it shall bear his iniquity, because he hath profaned the hallowed thing of the LORD: and that soul shall be cut off from among his people.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LEV.19.9",
      "edition_verse_id": "KJV1769:LEV.19.9",
      "verse": 9,
      "spans": [
        {
          "text": "¶ And when ye reap the harvest of your land, thou shalt not wholly reap the corners of thy field, neither shalt thou gather the gleanings of thy harvest.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "LEV.19.10",
      "edition_verse_id": "KJV1769:LEV.19.10",
      "verse": 10,
      "spans": [
        {
          "text": "And thou shalt not glean thy vineyard, neither shalt thou gather ",
          "kind": "text"
        },
        {
          "text": "every",
          "kind": "supplied"
        },
        {
          "text": " grape of thy vineyard; thou shalt leave them for the poor and stranger: I ",
          "kind": "text"
        },
        {
          "text": "am",
          "kind": "supplied"
        },
        {
          "text": " the LORD your God.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LEV.19.11",
      "edition_verse_id": "KJV1769:LEV.19.11",
      "verse": 11,
      "spans": [
        {
          "text": "¶ Ye shall not steal, neither deal falsely, neither lie one to another.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "LEV.19.12",
      "edition_verse_id": "KJV1769:LEV.19.12",
      "verse": 12,
      "spans": [
        {
          "text": "¶ And ye shall not swear by my name falsely, neither shalt thou profane the name of thy God: I ",
          "kind": "text"
        },
        {
          "text": "am",
          "kind": "supplied"
        },
        {
          "text": " the LORD.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "LEV.19.13",
      "edition_verse_id": "KJV1769:LEV.19.13",
      "verse": 13,
      "spans": [
        {
          "text": "¶ Thou shalt not defraud thy neighbour, neither rob ",
          "kind": "text"
        },
        {
          "text": "him:",
          "kind": "supplied"
        },
        {
          "text": " the wages of him that is hired shall not abide with thee all night until the morning.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "LEV.19.14",
      "edition_verse_id": "KJV1769:LEV.19.14",
      "verse": 14,
      "spans": [
        {
          "text": "¶ Thou shalt not curse the deaf, nor put a stumblingblock before the blind, but shalt fear thy God: I ",
          "kind": "text"
        },
        {
          "text": "am",
          "kind": "supplied"
        },
        {
          "text": " the LORD.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "LEV.19.15",
      "edition_verse_id": "KJV1769:LEV.19.15",
      "verse": 15,
      "spans": [
        {
          "text": "¶ Ye shall do no unrighteousness in judgment: thou shalt not respect the person of the poor, nor honour the person of the mighty: ",
          "kind": "text"
        },
        {
          "text": "but",
          "kind": "supplied"
        },
        {
          "text": " in righteousness shalt thou judge thy neighbour.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "LEV.19.16",
      "edition_verse_id": "KJV1769:LEV.19.16",
      "verse": 16,
      "spans": [
        {
          "text": "¶ Thou shalt not go up and down ",
          "kind": "text"
        },
        {
          "text": "as",
          "kind": "supplied"
        },
        {
          "text": " a talebearer among thy people: neither shalt thou stand against the blood of thy neighbour: I ",
          "kind": "text"
        },
        {
          "text": "am",
          "kind": "supplied"
        },
        {
          "text": " the LORD.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "LEV.19.17",
      "edition_verse_id": "KJV1769:LEV.19.17",
      "verse": 17,
      "spans": [
        {
          "text": "¶ Thou shalt not hate thy brother in thine heart: thou shalt in any wise rebuke thy neighbour, and not suffer sin upon him.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "LEV.19.18",
      "edition_verse_id": "KJV1769:LEV.19.18",
      "verse": 18,
      "spans": [
        {
          "text": "¶ Thou shalt not avenge, nor bear any grudge against the children of thy people, but thou shalt love thy neighbour as thyself: I ",
          "kind": "text"
        },
        {
          "text": "am",
          "kind": "supplied"
        },
        {
          "text": " the LORD.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "LEV.19.19",
      "edition_verse_id": "KJV1769:LEV.19.19",
      "verse": 19,
      "spans": [
        {
          "text": "¶ Ye shall keep my statutes. Thou shalt not let thy cattle gender with a diverse kind: thou shalt not sow thy field with mingled seed: neither shall a garment mingled of linen and woollen come upon thee.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "LEV.19.20",
      "edition_verse_id": "KJV1769:LEV.19.20",
      "verse": 20,
      "spans": [
        {
          "text": "¶ And whosoever lieth carnally with a woman, that ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " a bondmaid, betrothed to an husband, and not at all redeemed, nor freedom given her; she shall be scourged; they shall not be put to death, because she was not free.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "LEV.19.21",
      "edition_verse_id": "KJV1769:LEV.19.21",
      "verse": 21,
      "spans": [
        {
          "text": "And he shall bring his trespass offering unto the LORD, unto the door of the tabernacle of the congregation, ",
          "kind": "text"
        },
        {
          "text": "even",
          "kind": "supplied"
        },
        {
          "text": " a ram for a trespass offering.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LEV.19.22",
      "edition_verse_id": "KJV1769:LEV.19.22",
      "verse": 22,
      "spans": [
        {
          "text": "And the priest shall make an atonement for him with the ram of the trespass offering before the LORD for his sin which he hath done: and the sin which he hath done shall be forgiven him.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LEV.19.23",
      "edition_verse_id": "KJV1769:LEV.19.23",
      "verse": 23,
      "spans": [
        {
          "text": "¶ And when ye shall come into the land, and shall have planted all manner of trees for food, then ye shall count the fruit thereof as uncircumcised: three years shall it be as uncircumcised unto you: it shall not be eaten of.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "LEV.19.24",
      "edition_verse_id": "KJV1769:LEV.19.24",
      "verse": 24,
      "spans": [
        {
          "text": "But in the fourth year all the fruit thereof shall be holy to praise the LORD ",
          "kind": "text"
        },
        {
          "text": "withal",
          "kind": "supplied"
        },
        {
          "text": ".",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LEV.19.25",
      "edition_verse_id": "KJV1769:LEV.19.25",
      "verse": 25,
      "spans": [
        {
          "text": "And in the fifth year shall ye eat of the fruit thereof, that it may yield unto you the increase thereof: I ",
          "kind": "text"
        },
        {
          "text": "am",
          "kind": "supplied"
        },
        {
          "text": " the LORD your God.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LEV.19.26",
      "edition_verse_id": "KJV1769:LEV.19.26",
      "verse": 26,
      "spans": [
        {
          "text": "¶ Ye shall not eat ",
          "kind": "text"
        },
        {
          "text": "any thing",
          "kind": "supplied"
        },
        {
          "text": " with the blood: neither shall ye use enchantment, nor observe times.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "LEV.19.27",
      "edition_verse_id": "KJV1769:LEV.19.27",
      "verse": 27,
      "spans": [
        {
          "text": "Ye shall not round the corners of your heads, neither shalt thou mar the corners of thy beard.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LEV.19.28",
      "edition_verse_id": "KJV1769:LEV.19.28",
      "verse": 28,
      "spans": [
        {
          "text": "Ye shall not make any cuttings in your flesh for the dead, nor print any marks upon you: I ",
          "kind": "text"
        },
        {
          "text": "am",
          "kind": "supplied"
        },
        {
          "text": " the LORD.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
