      "id": "LEV.19.35",
      "edition_verse_id": "KJV1769:LEV.19.35",
      "verse": 35,
      "spans": [
        {
          "text": "¶ Ye shall do no unrighteousness in judgment, in meteyard, in weight, or in measure.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "LEV.19.36",
      "edition_verse_id": "KJV1769:LEV.19.36",
      "verse": 36,
      "spans": [
        {
          "text": "Just balances, just weights, a just ephah, and a just hin, shall ye have: I ",
          "kind": "text"
        },
        {
          "text": "am",
          "kind": "supplied"
        },
        {
          "text": " the LORD your God, which brought you out of the land of Egypt.",
          "kind": "text"
        }
