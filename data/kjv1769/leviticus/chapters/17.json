  "chapter": 17,
  "verses": [
    {
      "id": "LEV.17.1",
      "edition_verse_id": "KJV1769:LEV.17.1",
      "verse": 1,
      "spans": [
        {
          "text": "And the LORD spake unto Moses, saying,",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "LEV.17.2",
      "edition_verse_id": "KJV1769:LEV.17.2",
      "verse": 2,
      "spans": [
        {
          "text": "Speak unto Aaron, and unto his sons, and unto all the children of Israel, and say unto them; This ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " the thing which the LORD hath commanded, saying,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LEV.17.3",
      "edition_verse_id": "KJV1769:LEV.17.3",
      "verse": 3,
      "spans": [
        {
          "text": "What man soever ",
          "kind": "text"
        },
        {
          "text": "there be",
          "kind": "supplied"
        },
        {
          "text": " of the house of Israel, that killeth an ox, or lamb, or goat, in the camp, or that killeth ",
          "kind": "text"
        },
        {
          "text": "it",
          "kind": "supplied"
        },
        {
          "text": " out of the camp,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LEV.17.4",
      "edition_verse_id": "KJV1769:LEV.17.4",
      "verse": 4,
      "spans": [
        {
          "text": "And bringeth it not unto the door of the tabernacle of the congregation, to offer an offering unto the LORD before the tabernacle of the LORD; blood shall be imputed unto that man; he hath shed blood; and that man shall be cut off from among his people:",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LEV.17.5",
      "edition_verse_id": "KJV1769:LEV.17.5",
      "verse": 5,
      "spans": [
        {
          "text": "To the end that the children of Israel may bring their sacrifices, which they offer in the open field, even that they may bring them unto the LORD, unto the door of the tabernacle of the congregation, unto the priest, and offer them ",
          "kind": "text"
        },
        {
          "text": "for",
          "kind": "supplied"
        },
        {
          "text": " peace offerings unto the LORD.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LEV.17.6",
      "edition_verse_id": "KJV1769:LEV.17.6",
      "verse": 6,
      "spans": [
        {
          "text": "And the priest shall sprinkle the blood upon the altar of the LORD ",
          "kind": "text"
        },
        {
          "text": "at",
          "kind": "supplied"
        },
        {
          "text": " the door of the tabernacle of the congregation, and burn the fat for a sweet savour unto the LORD.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LEV.17.7",
      "edition_verse_id": "KJV1769:LEV.17.7",
      "verse": 7,
      "spans": [
        {
          "text": "And they shall no more offer their sacrifices unto devils, after whom they have gone a whoring. This shall be a statute for ever unto them throughout their generations.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LEV.17.8",
      "edition_verse_id": "KJV1769:LEV.17.8",
      "verse": 8,
      "spans": [
        {
          "text": "¶ And thou shalt say unto them, Whatsoever man ",
          "kind": "text"
        },
        {
          "text": "there be",
          "kind": "supplied"
        },
        {
          "text": " of the house of Israel, or of the strangers which sojourn among you, that offereth a burnt offering or sacrifice,",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "LEV.17.9",
      "edition_verse_id": "KJV1769:LEV.17.9",
      "verse": 9,
      "spans": [
        {
          "text": "And bringeth it not unto the door of the tabernacle of the congregation, to offer it unto the LORD; even that man shall be cut off from among his people.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LEV.17.10",
      "edition_verse_id": "KJV1769:LEV.17.10",
      "verse": 10,
      "spans": [
        {
          "text": "¶ And whatsoever man ",
          "kind": "text"
        },
        {
          "text": "there be",
          "kind": "supplied"
        },
        {
          "text": " of the house of Israel, or of the strangers that sojourn among you, that eateth any manner of blood; I will even set my face against that soul that eateth blood, and will cut him off from among his people.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "LEV.17.11",
      "edition_verse_id": "KJV1769:LEV.17.11",
      "verse": 11,
      "spans": [
        {
          "text": "For the life of the flesh ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " in the blood: and I have given it to you upon the altar to make an atonement for your souls: for it ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " the blood ",
          "kind": "text"
        },
        {
          "text": "that",
          "kind": "supplied"
        },
        {
          "text": " maketh an atonement for the soul.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LEV.17.12",
      "edition_verse_id": "KJV1769:LEV.17.12",
      "verse": 12,
      "spans": [
        {
          "text": "Therefore I said unto the children of Israel, No soul of you shall eat blood, neither shall any stranger that sojourneth among you eat blood.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LEV.17.13",
      "edition_verse_id": "KJV1769:LEV.17.13",
      "verse": 13,
      "spans": [
        {
          "text": "And whatsoever man ",
          "kind": "text"
        },
        {
          "text": "there be",
          "kind": "supplied"
        },
        {
          "text": " of the children of Israel, or of the strangers that sojourn among you, which hunteth and catcheth any beast or fowl that may be eaten; he shall even pour out the blood thereof, and cover it with dust.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LEV.17.14",
      "edition_verse_id": "KJV1769:LEV.17.14",
      "verse": 14,
      "spans": [
        {
          "text": "For ",
          "kind": "text"
        },
        {
          "text": "it is",
          "kind": "supplied"
        },
        {
          "text": " the life of all flesh; the blood of it ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " for the life thereof: therefore I said unto the children of Israel, Ye shall eat the blood of no manner of flesh: for the life of all flesh ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " the blood thereof: whosoever eateth it shall be cut off.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LEV.17.15",
      "edition_verse_id": "KJV1769:LEV.17.15",
      "verse": 15,
      "spans": [
        {
          "text": "And every soul that eateth that which died ",
          "kind": "text"
        },
        {
          "text": "of itself",
          "kind": "supplied"
        },
        {
          "text": ", or that which was torn ",
          "kind": "text"
        },
        {
          "text": "with beasts, whether it be",
          "kind": "supplied"
        },
        {
          "text": " one of your own country, or a stranger, he shall both wash his clothes, and bathe ",
          "kind": "text"
        },
        {
          "text": "himself",
          "kind": "supplied"
        },
        {
          "text": " in water, and be unclean until the even: then shall he be clean.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LEV.17.16",
      "edition_verse_id": "KJV1769:LEV.17.16",
      "verse": 16,
      "spans": [
        {
          "text": "But if he wash ",
          "kind": "text"
        },
        {
          "text": "them",
          "kind": "supplied"
        },
        {
          "text": " not, nor bathe his flesh; then he shall bear his iniquity.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    }
  ]
}
